PORT=8000

# PostgreSQL Database Configuration
# Leave DB_PASSWORD empty to use the built-in SQLite fallback for local development.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=docsentinel_app
DB_USER=postgres
DB_PASSWORD=

# OCR / Document-processing pipeline
OCR_ENGINE=hybrid
OCR_LANGUAGE=auto
OCR_PAGE_SEG_MODE=6
OCR_RENDER_DPI=300
OCR_TESSDATA_PATH=
OCR_BLANK_THRESHOLD=0.08
OCR_MIN_TEXT_PIXELS=150
OCR_PREPROCESS_DENOISE=true
OCR_ALLOW_VISION_MODEL=false
OCR_VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
OCR_BENCHMARK_PDF=

# Optional OpenAI-compatible RAG chat provider (leave blank for retrieval-only mode)
RAG_LLM_BASE_URL=
RAG_LLM_MODEL=
RAG_LLM_API_KEY=
RAG_LLM_TIMEOUT_SECONDS=30
RAG_RETRIEVAL_TOP_K=8
RAG_MIN_SIMILARITY=0.2

# JWT Authentication
JWT_SECRET=generate_a_secure_random_jwt_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Default Initial Administrator
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
